{
  "entities": {
    "UserPublic": {
      "title": "UserPublic",
      "description": "Public non-PII user display metadata.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "createdAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private PII profile and saved courier address accessible only to owner or admin.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "mobile": { "type": "string", "minLength": 10, "maxLength": 20 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "streetAddress": { "type": "string", "maxLength": 300 },
        "landmark": { "type": "string", "maxLength": 150 },
        "city": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "pincode": { "type": "string", "pattern": "^[0-9]{6}$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "mobile", "email", "updatedAt"]
    },
    "UserCartItem": {
      "title": "UserCartItem",
      "description": "Authenticated customer's synced shopping cart item.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "qty": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productId", "qty", "updatedAt"]
    },
    "UserWishlistItem": {
      "title": "UserWishlistItem",
      "description": "Authenticated customer's synced wishlist product reference.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productId", "addedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized store administrator record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "role": { "type": "string", "enum": ["admin", "super_admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "ShivAmrit Healers authoritative product catalog entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "nameHi": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "braceletType": { "type": "string", "enum": ["single", "combination", "none"] },
        "price": { "type": "number" },
        "compareAtPrice": { "type": "number" },
        "inventory": { "type": "integer" },
        "stockStatus": { "type": "string", "enum": ["in", "low", "out"] },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "category", "price", "inventory", "stockStatus", "active"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Store coupon rule managed by admins.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 2, "maxLength": 40 },
        "discountType": { "type": "string", "enum": ["percent", "fixed", "freeship"] },
        "value": { "type": "number" },
        "minSubtotal": { "type": "number" },
        "active": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 200 }
      },
      "required": ["code", "discountType", "value", "minSubtotal", "active"]
    },
    "Order": {
      "title": "Order",
      "description": "Server-validated customer order record.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "minLength": 4, "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "customerPhone": { "type": "string", "minLength": 10, "maxLength": 20 },
        "customerEmail": { "type": "string", "maxLength": 160 },
        "shippingStreet": { "type": "string", "minLength": 2, "maxLength": 300 },
        "shippingCity": { "type": "string", "minLength": 1, "maxLength": 100 },
        "shippingPincode": { "type": "string", "pattern": "^[0-9]{6}$" },
        "subtotal": { "type": "number" },
        "discountAmount": { "type": "number" },
        "shippingFee": { "type": "number" },
        "grandTotal": { "type": "number" },
        "couponCode": { "type": "string", "maxLength": 40 },
        "paymentMethod": { "type": "string", "enum": ["razorpay", "cod"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "failed", "cod_pending", "refunded"] },
        "fulfillmentStatus": { "type": "string", "enum": ["pending_payment", "processing", "packed", "shipped", "delivered", "cancelled", "returned"] },
        "razorpayOrderId": { "type": "string", "maxLength": 128 },
        "razorpayPaymentId": { "type": "string", "maxLength": 128 },
        "trackingNumber": { "type": "string", "maxLength": 128 },
        "courierName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "customerName", "customerPhone", "subtotal", "grandTotal", "paymentMethod", "paymentStatus", "fulfillmentStatus", "createdAt", "updatedAt"]
    },
    "OrderItem": {
      "title": "OrderItem",
      "description": "Immutable order line item stored inside an order subcollection.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "minLength": 4, "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "unitPrice": { "type": "number" },
        "qty": { "type": "integer" },
        "lineTotal": { "type": "number" }
      },
      "required": ["orderId", "productId", "name", "unitPrice", "qty", "lineTotal"]
    },
    "ConsultationBooking": {
      "title": "ConsultationBooking",
      "description": "Healing consultation appointment booking.",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string", "minLength": 4, "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "serviceId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "serviceName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "customerPhone": { "type": "string", "minLength": 10, "maxLength": 20 },
        "customerEmail": { "type": "string", "maxLength": 160 },
        "preferredDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "preferredSlot": { "type": "string", "minLength": 3, "maxLength": 40 },
        "notes": { "type": "string", "maxLength": 500 },
        "fee": { "type": "number" },
        "bookingStatus": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["bookingId", "serviceId", "serviceName", "customerName", "customerPhone", "preferredDate", "preferredSlot", "fee", "bookingStatus", "createdAt", "updatedAt"]
    },
    "Workshop": {
      "title": "Workshop",
      "description": "Spiritual healing workshop or masterclass event.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "dateLabel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "timeLabel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "fee": { "type": "number" },
        "totalSeats": { "type": "integer" },
        "seatsBooked": { "type": "integer" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "title", "dateLabel", "timeLabel", "fee", "totalSeats", "seatsBooked", "active"]
    },
    "WorkshopRegistration": {
      "title": "WorkshopRegistration",
      "description": "Attendee registration for a workshop.",
      "type": "object",
      "properties": {
        "registrationId": { "type": "string", "minLength": 4, "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "workshopId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workshopTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "participantName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "participantPhone": { "type": "string", "minLength": 10, "maxLength": 20 },
        "participantEmail": { "type": "string", "maxLength": 160 },
        "seats": { "type": "integer" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["registrationId", "workshopId", "workshopTitle", "participantName", "participantPhone", "seats", "amount", "status", "createdAt"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "Opt-in newsletter subscriber record.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "consent": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "consent", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Moderated customer product review.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "rating": { "type": "integer" },
        "comment": { "type": "string", "minLength": 5, "maxLength": 1000 },
        "verifiedPurchase": { "type": "boolean" },
        "approved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "userId", "authorName", "rating", "comment", "verifiedPurchase", "approved", "createdAt"]
    },
    "LeadInquiry": {
      "title": "LeadInquiry",
      "description": "Hero slideshow consultation, workshop, and crystal inquiry lead record.",
      "type": "object",
      "properties": {
        "leadId": { "type": "string", "minLength": 4, "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 10, "maxLength": 20 },
        "email": { "type": "string", "maxLength": 160 },
        "interest": { "type": "string", "minLength": 2, "maxLength": 120 },
        "message": { "type": "string", "maxLength": 500 },
        "sourceSlide": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "enum": ["new", "contacted", "converted"] },
        "sheetSynced": { "type": "boolean" },
        "sheetSyncedAt": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["leadId", "name", "phone", "interest", "status", "sheetSynced", "createdAt", "updatedAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable admin action audit trail.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 160 },
        "action": { "type": "string", "minLength": 1, "maxLength": 100 },
        "targetId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "action", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Public non-PII user document."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Private user PII profile and saved courier address."
    },
    "/users/{userId}/cart/{itemId}": {
      "schema": { "$ref": "#/entities/UserCartItem" },
      "description": "Authenticated user synced cart items."
    },
    "/users/{userId}/wishlist/{productId}": {
      "schema": { "$ref": "#/entities/UserWishlistItem" },
      "description": "Authenticated user synced wishlist items."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized admin role registry."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Authoritative product catalog."
    },
    "/coupons/{couponCode}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Server-validated discount coupons."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Persistent customer orders."
    },
    "/orders/{orderId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/OrderItem" },
      "description": "Order line items subcollection."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/ConsultationBooking" },
      "description": "Spiritual consultation bookings."
    },
    "/workshops/{workshopId}": {
      "schema": { "$ref": "#/entities/Workshop" },
      "description": "Healing workshops and masterclasses."
    },
    "/workshopRegistrations/{registrationId}": {
      "schema": { "$ref": "#/entities/WorkshopRegistration" },
      "description": "Workshop participant registrations."
    },
    "/newsletterSubscribers/{subscriberId}": {
      "schema": { "$ref": "#/entities/NewsletterSubscriber" },
      "description": "Opt-in newsletter subscribers."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Customer product reviews."
    },
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/LeadInquiry" },
      "description": "Hero consultation, workshop, and crystal inquiry leads."
    },
    "/adminAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Admin audit trail."
    }
  }
}
